{
  // F5(디버그) 또는 Ctrl+F5(디버그 없이)로 실행. 왼쪽 '실행 및 디버그'에서 항목을 고른다.
  // 처음에는 '1. 환경 설치'를 먼저 실행한다. 나머지는 .venv의 Python으로 바로 실행되어 중단점도 걸린다.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. 환경 설치 (처음 한 번)",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/실행/1_환경설치.py",
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "justMyCode": true
    },
    {
      "name": "2. 시뮬레이션 학습 + 평가",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_all.py",
      "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "3. 대시보드",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "streamlit",
      "args": ["run", "dashboard/app.py", "--server.port", "8501", "--server.headless", "true"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" },
      "serverReadyAction": { "pattern": "(http://localhost:[0-9]+)", "uriFormat": "%s", "action": "openExternally" }
    },
    {
      "name": "4. 내 데이터 검사",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_custom.py",
      "args": ["check"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "5. 내 데이터로 학습",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_custom.py",
      "args": ["train", "--holdout", "${input:holdout}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "6. 내 데이터 진단",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_custom.py",
      "args": ["diagnose", "--model", "${input:model}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "예시 데이터 만들기",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_custom.py",
      "args": ["sample"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "로봇 1대 시뮬레이션 진단",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_monitor.py",
      "args": ["${input:kind}", "right"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    }
  ],
  "inputs": [
    { "id": "holdout", "type": "promptString", "description": "학습에서 뺄 로봇 (쉼표로 구분, 없으면 비워 두기)", "default": "" },
    { "id": "model", "type": "pickString", "description": "진단 모델", "options": ["auto", "user", "sim"], "default": "auto" },
    { "id": "kind", "type": "pickString", "description": "고장 종류", "options": ["bearing", "looseness", "unbalance", "normal"], "default": "bearing" }
  ]
}
