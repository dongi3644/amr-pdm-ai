{
  // VS Code 왼쪽 '실행 및 디버그'(Ctrl+Shift+D) 목록에서 골라 ▶ (또는 F5). 처음에는 '1. 환경 설치'를 먼저 실행한다.
  // 실행 중에는 아래 터미널에 지금 하는 작업이 처음 한 번, 그 뒤 5분마다 나온다 (예: [14:03:10] ▶ 학습 중).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. 환경 설치 (처음 한 번)",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/실행/1_환경설치.py",
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "2. 데이터 검사 (check)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run.py", "args": ["check"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "3. 학습 + 교차검증 (train)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run.py", "args": ["train"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "4. 진단 (diagnose)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run.py", "args": ["diagnose"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "5. 실시간 알림 (아두이노 USB 연결, 받은 데이터 저장)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run.py", "args": ["live"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "실시간 알림 시연 (가상 고장 로봇, 10배 빠르게)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run.py", "args": ["live", "--demo", "--speed", "10"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "최종 시험 1: 실측 + 가상 학습, 조건별 시험 (약 40분, data/ 아래 실측 폴더 4개 필요)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/가상테스트/실측혼합_시험.py",
      "args": ["--g3", "data/정상 데이터_공3옥상", "--g3", "data/정상 데이터_공3옥상(11.16)",
               "--yg", "data/정상 데이터_욧골(11.15)", "--fault", "data/고장 데이터_욧골", "--jobs", "8"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "최종 시험 2: 검증 로봇으로 판정 설정 고르기 + 시험 (약 40분, 최종 시험 1 다음)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/가상테스트/실측혼합_조정.py",
      "args": ["--g3", "data/정상 데이터_공3옥상", "--g3", "data/정상 데이터_공3옥상(11.16)",
               "--yg", "data/정상 데이터_욧골(11.15)", "--fault", "data/고장 데이터_욧골", "--jobs", "8"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "가상 시험: 빠른 코드 확인 (약 4분, 실측 데이터 없이)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/가상테스트/test_complex.py",
      "args": ["--scale", "0.1"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "0. 아두이노 기록 (저장소 스케치를 쓸 때만, USB 연결 후)",
      "type": "debugpy", "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/실행/0_아두이노_기록.py",
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "env": { "PYTHONUTF8": "1" }
    }
  ]
}
